PORT=4000
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Postgres connection string. Required (npm start needs it locally, and
# Vercel needs it set as a project Environment Variable in production).
# Any Postgres works: a local install, Docker, Vercel Postgres, Neon,
# Supabase, Railway, etc.
DATABASE_URL=postgres://user:password@localhost:5432/dylrealestateservices

# Left blank by default so any origin can call the API (fine for local dev
# with Live Server, Vite, or opening HTML files directly). Once you're
# deploying somewhere real, uncomment and set these to your actual frontend
# URLs to lock CORS down.
# CLIENT_ORIGIN=http://localhost:5173
# ADMIN_ORIGIN=http://localhost:5174

# Google OAuth Web client ID. Use the same public client ID configured in
# user-site/js/env.js and add it to the backend hosting environment.
# GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com

# Seed admin account (created automatically on first run if no admin exists)
SEED_ADMIN_EMAIL=admin@dylrealestateservices.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional SMTP settings for sending password reset emails. Without these,
# reset links are logged by the backend for local development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=mailer@example.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=mailer@example.com
