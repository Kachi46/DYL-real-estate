PORT=4000
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Postgres connection string. Required for local/standalone use (npm start).
# Any Postgres works: a local install, Docker, or a free hosted instance
# (Neon, Supabase, Railway, etc). Not needed if you're running via
# `netlify dev` with a linked Netlify DB - that injects its own connection
# automatically.
DATABASE_URL=postgres://user:password@localhost:5432/veriestate

# Left blank by default so any origin can call the API (fine for local dev
# with Live Server, Vite, or opening HTML files directly). Once you're
# deploying somewhere real, uncomment and set these to your actual frontend
# URLs to lock CORS down.
# CLIENT_ORIGIN=http://localhost:5173
# ADMIN_ORIGIN=http://localhost:5174

# Seed admin account (created automatically on first run if no admin exists)
SEED_ADMIN_EMAIL=admin@veriestate.com
SEED_ADMIN_PASSWORD=ChangeMe123!
